# Copy to .env and fill in. Never commit .env.
# Generate random secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Public origin of the app, no trailing slash.
# Local: http://localhost:3000   Production: https://<your-project>.vercel.app
APP_URL=

# Postgres connection string (Neon: use the pooled connection string, sslmode=require).
DATABASE_URL=

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps).
# Authorization callback URL must be: ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret used to sign webhooks the app registers on connected repositories (>= 16 chars).
GITHUB_WEBHOOK_SECRET=

# 32 random bytes, base64. Encrypts GitHub tokens and Slack URLs at rest.
TOKEN_ENCRYPTION_KEY=

# Bearer secret for /api/cron/worker (Vercel Cron + GitHub Actions scheduler) (>= 16 chars).
CRON_SECRET=

# Optional default Slack Incoming Webhook URL (https://hooks.slack.com/services/...), used for
# users who have not saved their own in Settings. It contains a secret: never commit it.
SLACK_WEBHOOK_URL=

# Optional. Public HTTPS URL that GitHub should deliver repository webhooks to.
# Leave empty in production (defaults to ${APP_URL}/api/webhooks/github).
# GitHub rejects localhost, so for local development use a tunnel, e.g.
#   cloudflared tunnel --url http://localhost:3000
# and set this to https://<random>.trycloudflare.com/api/webhooks/github
GITHUB_WEBHOOK_URL=
